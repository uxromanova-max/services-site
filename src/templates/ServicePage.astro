---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import Faq from '../components/Faq.astro';
import ServiceTop from '../components/service/ServiceTop.astro';
import ArrowLists from '../components/service/ArrowLists.astro';
import NeedTools from '../components/service/NeedTools.astro';
import PriceCards from '../components/service/PriceCards.astro';
import banner from '../assets/figma/service-banner.png';
import sideWide from '../assets/figma/service-side-wide.png';
import { getSite } from '../lib/site';
import { legalHref } from '../lib/routes';
import { fromPrice, getShared, resolveFaq } from '../lib/service';

interface Props {
  service: CollectionEntry<'services'>['data'];
}

const { service: s } = Astro.props;
const site = await getSite();
const L = (await getShared()).servicePage;
const termsHref = await legalHref('terms');
const faq = await resolveFaq(s);
---

<Base title={s.name} description={s.pain}>
  <ServiceTop title={s.name} pain={s.pain!} price={fromPrice(s.from)} timeline={s.timeline} labels={L} termsHref={termsHref} />
  <ArrowLists familiarHeading={L.familiarHeading} getHeading={L.getHeading} familiar={s.familiar!} get={s.get!} />

  <div class="container">
    <Image class="banner" src={banner} alt="" width={1072} height={361} densities={[1, 2]} format="webp" loading="lazy" />
  </div>

  <section class="container steps-block" aria-labelledby="steps-title">
    <h2 id="steps-title" class="block-label">{L.stepsHeading}</h2>
    <ol class="steps" role="list">
      {
        s.steps?.map((step) => (
          <li>
            <span class="step-label">[ {step.label} ]</span>
            <span class="step-text">{step.text}</span>
          </li>
        ))
      }
    </ol>
  </section>

  <div class="need-wrap">
    <NeedTools needHeading={L.needHeading} toolsHeading={L.toolsHeading} need={s.need!} tools={s.tools!} wideImage={sideWide} wideHeight={226} />
  </div>

  <div class="price-wrap">
    <PriceCards
      heading={L.priceHeading}
      popularLabel={L.popularLabel}
      goesUpHeading={L.goesUpHeading}
      packages={s.packages!}
      goesUpWith={s.goesUpWith!}
      priceNote={s.priceNote}
    />
  </div>

  <div class="faq-wrap">
    <Faq heading={L.questionsHeading} bookLabel={L.bookLabel} bookingUrl={site.bookingUrl} items={faq} />
  </div>
</Base>

<style>
  /* Figma "Service page template" (12:948); shared blocks live in components/service. */
  .banner {
    width: 100%;
    height: auto;
    margin-top: 80px;
  }
  .steps-block {
    margin-top: 88px;
  }
  .steps {
    display: grid;
    grid-template-columns: repeat(4, 204px);
    justify-content: space-between;
    margin: 40px 0 0;
    padding: 0;
    list-style: none;
  }
  .steps li {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .step-label {
    color: var(--color-step);
    letter-spacing: 0.08em;
  }
  .step-text {
    font-size: var(--text-lead);
  }
  .need-wrap {
    margin-top: 86px;
  }
  .price-wrap {
    margin-top: 88px;
  }
  .faq-wrap {
    margin-top: 28px;
  }

  @media (max-width: 75rem) {
    .steps {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      column-gap: var(--space-6);
    }
  }
  @media (max-width: 48rem) {
    .steps {
      grid-template-columns: 1fr 1fr;
      row-gap: var(--space-8);
    }
  }
</style>

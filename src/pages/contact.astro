---
import Base from '../layouts/Base.astro';
import { getSite, isUnresolved } from '../lib/site';

// Provisional: there is no Figma frame for this page. Diana (design review): the Cal.com booking
// widget comes first and there is no email form on this page.
const site = await getSite();
const c = site.contact;
const calReady = !isUnresolved(c.calUrl);
---

<Base title={site.nav.bookLabel}>
  <section class="container booking" aria-labelledby="booking-title">
    <h1 id="booking-title" class="title">{site.nav.bookLabel}</h1>
    <div class:list={['embed', { unresolved: !calReady }]} id="cal-embed">
      {calReady ? null : <p>{c.calUrl}</p>}
    </div>
    <p class="fallback">
      {
        calReady ? (
          <a class="link-arrow" href={c.calUrl} rel="noopener" target="_blank">
            {site.cta.bookLabel}
            <span class="icon icon-arrow-up-right" aria-hidden="true" />
            <span class="visually-hidden">(opens in a new tab)</span>
          </a>
        ) : (
          <span class="unresolved">{site.cta.bookLabel} ({c.calUrl})</span>
        )
      }
      <a class="email" href={`mailto:${site.email}`}>{site.email}</a>
    </p>
  </section>
</Base>

<style>
  .booking {
    padding-top: calc(145px - var(--nav-h));
    padding-bottom: var(--space-16);
  }
  .title {
    font-family: var(--font-display);
    font-size: var(--text-display);
    font-weight: var(--weight-regular);
    line-height: normal;
  }
  .embed {
    display: grid;
    place-items: center;
    min-height: 640px;
    margin-top: 40px;
    border: 1px dashed var(--color-dash);
  }
  .fallback {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-4);
    margin-top: var(--space-6);
  }
  .email {
    font-weight: var(--weight-regular);
    text-underline-position: from-font;
  }
</style>

---
import { getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import Hero from '../components/home/Hero.astro';
import About from '../components/home/About.astro';
import SelectedWorks from '../components/home/SelectedWorks.astro';
import ServicesGrid from '../components/home/ServicesGrid.astro';
import Faq from '../components/Faq.astro';
import CtaForm from '../components/CtaForm.astro';
import { getSite } from '../lib/site';

const site = await getSite();
const home = await getEntry('home', 'home');
if (!home) throw new Error('content/home.md is missing');
const { hero, about, work, services, faq } = home.data;
---

<Base landingNav description={hero.subline}>
  <Hero hero={hero} bookingUrl={site.bookingUrl} />
  <About about={about} />
  <SelectedWorks work={work} />
  <ServicesGrid services={services} />
  <Faq heading={faq.heading} bookLabel={faq.bookLabel} bookingUrl={site.bookingUrl} items={faq.items} />
  <CtaForm />
</Base>

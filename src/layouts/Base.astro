---
import '@fontsource/geist/latin-300.css';
import '@fontsource/geist/latin-400.css';
import '@fontsource/geist/latin-500.css';
import '@fontsource/geist/latin-600.css';
import '@fontsource/geist/latin-700.css';
import '@fontsource/sometype-mono/latin-400-italic.css';
import '@fontsource/cinzel-decorative/latin-400.css';
import '@fontsource/cormorant-infant/latin-400.css';
import '@fontsource/cormorant-infant/latin-600.css';
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { allowIndexing, isProduction } from '../lib/env';
import { getSite } from '../lib/site';
import { legalHref } from '../lib/routes';

interface Props {
  title?: string;
  description?: string;
  /** Draft pages are noindex and carry a banner outside production. */
  draft?: boolean;
  /** Landing variant of the nav (location lines under the name). */
  landingNav?: boolean;
}

const { title, description, draft = false, landingNav = false } = Astro.props;
const site = await getSite();
const pageTitle = title ? `${title} · ${site.name}` : site.name;
const noindex = !allowIndexing || draft;
const privacyHref = await legalHref('privacy');
const termsHref = await legalHref('terms');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="preload" href="/fonts/jeju-myeongjo-latin-400.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline>
      // Scroll reveal is on only when motion is allowed and the browser can observe scrolling.
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window)
        document.documentElement.classList.add('reveal');
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    {draft && !isProduction && <p class="draft-banner unresolved">Draft page: not published in production.</p>}
    <Nav showLocation={landingNav} />
    <main id="main">
      <slot />
    </main>
    <Footer privacyHref={privacyHref} termsHref={termsHref} />
    <script is:inline>
      // Scroll reveal (Diana, design reviews 1-5). Blocks appear as they enter the screen, with a
      // few related motions so the page does not move in one direction only:
      //   blur  - photos, bands and large display headings come out of a soft blur
      //   fade  - small labels and notes simply fade in
      //   left / right - the two columns of a split layout meet in the middle
      //   up    - everything else, and cards in a row as a short wave
      // Backgrounds of the dark bands never move. Runs before first paint, so nothing flashes;
      // without JS or with reduced motion everything is simply visible.
      (function () {
        var root = document.documentElement;
        if (!root.classList.contains('reveal')) return;
        var STAGGER = '.grid > li, .packages > li, .steps > li, .match-rows > li, .cost-cards > li, .break-card, .proof > img';
        // Blocks that are opened up so their parts can move differently.
        var SPLIT = '.about, .body, .lists, .two-lists, .need-tools, .cta, .faq, .works, .top, .booking, .text-page, .cost, .cost-inner, .how, .match, .price-block, .services, .breaks, .row, .pair';
        var SKIP = 'script, style, .draft-banner, .hero, .band-bg, picture:has(.band-bg)';
        var VARIANTS = [
          ['blur', 'img, picture, figure, .photo, .side-images, .embed, .system, .title, .heading, .match-title, .wide'],
          ['fade', '.section-label, .block-label, .eyebrow, .key-message, .ongoing, .head, .cost-title, .cost-intro, .cost-footnote, .price-note, .stats, .more, .fallback'],
          ['left', '.lists > :first-child, .two-lists > :first-child, .need-col, .cta .intro, .row > :first-child'],
          ['right', '.lists > :last-child, .two-lists > :last-child, .cta .form, .row > :last-child, .faq .list'],
        ];
        var targets = [];
        function variantOf(el) {
          for (var i = 0; i < VARIANTS.length; i++) if (el.matches(VARIANTS[i][1])) return VARIANTS[i][0];
          return 'up';
        }
        function mark(el, variant) {
          var parent = el.parentElement;
          var index = parent ? parent.__revealIndex || 0 : 0;
          if (parent) parent.__revealIndex = index + 1;
          el.style.setProperty('--reveal-delay', Math.min(index, 5) * 0.09 + 's');
          el.setAttribute('data-reveal', variant || variantOf(el));
          targets.push(el);
        }
        function walk(el, depth) {
          if (el.matches(SKIP)) return;
          if (el.matches(STAGGER)) return mark(el, 'up');
          var split = depth === 0 || el.matches(SPLIT) || el.querySelector(STAGGER);
          if (!split || depth > 5 || !el.children.length) return mark(el);
          for (var i = 0; i < el.children.length; i++) walk(el.children[i], depth + 1);
        }
        var main = document.getElementById('main');
        if (main) for (var i = 0; i < main.children.length; i++) walk(main.children[i], 0);
        document.querySelectorAll('.footer .card').forEach(function (el) { mark(el, 'fade'); });
        function settle(el) {
          // Once it has arrived, drop the reveal styles so the element's own hover
          // transitions (buttons, links) are not overridden by the reveal transition.
          var delay = parseFloat(el.style.getPropertyValue('--reveal-delay')) || 0;
          setTimeout(function () {
            el.removeAttribute('data-reveal');
            el.classList.remove('is-visible');
          }, (delay + 2) * 1000);
        }
        // Page load (Diana, design review 5): whatever is on the first screen assembles one
        // block after another, top to bottom, on every page.
        var first = targets.filter(function (el) {
          var r = el.getBoundingClientRect();
          return r.top < window.innerHeight && r.bottom > 0;
        });
        first.sort(function (x, y) {
          var a = x.getBoundingClientRect(), b = y.getBoundingClientRect();
          return a.top - b.top || a.left - b.left;
        });
        first.forEach(function (el, i) {
          el.style.setProperty('--reveal-delay', Math.min(0.1 + i * 0.13, 1.4).toFixed(2) + 's');
        });
        targets = targets.filter(function (el) { return first.indexOf(el) < 0; });
        // Start only once the new page is actually on screen (Diana, design review 6). When you
        // follow a link, the browser keeps showing the old page until the new one first paints;
        // starting earlier let the animation run unseen. The nav stays visible, so there is
        // always content for that first paint. html.painted also releases the hero load-in.
        var started = false;
        function start() {
          if (started) return;
          started = true;
          root.classList.add('painted');
          requestAnimationFrame(function () {
            requestAnimationFrame(function () {
              first.forEach(function (el) {
                el.classList.add('is-visible');
                settle(el);
              });
            });
          });
        }
        var types = window.PerformanceObserver && PerformanceObserver.supportedEntryTypes;
        if (types && types.indexOf('paint') >= 0) {
          new PerformanceObserver(function (list, po) {
            po.disconnect();
            start();
          }).observe({ type: 'paint', buffered: true });
          setTimeout(start, 3000);
        } else {
          start();
        }
        var io = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (e) {
              if (!e.isIntersecting) return;
              var el = e.target;
              el.classList.add('is-visible');
              io.unobserve(el);
              settle(el);
            });
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
        );
        targets.forEach(function (el) { io.observe(el); });
      })();
    </script>
  </body>
</html>

<style>
  .draft-banner {
    padding: var(--space-2) var(--gutter-nav);
    font-size: var(--text-small);
  }
</style>

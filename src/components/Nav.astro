---
import { getSite } from '../lib/site';

interface Props {
  /** Landing shows "Based in Poland / Remote Worldwide" under the name. */
  showLocation?: boolean;
}

const { showLocation = false } = Astro.props;
const site = await getSite();
---

<header class="nav">
  <div class="brand">
    <a class="name" href="/">{site.name}</a>
    {
      showLocation && (
        <p class="location">
          {site.location.map((line, i) => (
            <>
              {i > 0 && <br />}
              {line}
            </>
          ))}
        </p>
      )
    }
  </div>
  <a class="link-fill" href={site.bookingUrl}>
    {site.nav.bookLabel}
    <span class="icon icon-arrow-up-right" aria-hidden="true"></span>
  </a>
</header>

<style>
  .nav {
    position: relative;
    z-index: 1;
    min-height: var(--nav-h);
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--space-4);
    max-width: calc(var(--content) + 2 * var(--gutter-nav));
    margin-inline: auto;
    padding: var(--space-8) var(--gutter-nav) 0;
  }
  .name {
    font-weight: var(--weight-semibold);
    text-transform: uppercase;
    text-decoration: none;
  }
  .location {
    margin-top: var(--space-2);
    font-size: var(--text-small);
    letter-spacing: var(--tracking-small);
  }
</style>

---
interface Props {
  heading: string;
  bookLabel: string;
  bookingUrl: string;
  items: { q: string; a: string | string[] }[];
}

const { heading, bookLabel, bookingUrl, items } = Astro.props;
const id = `faq-${heading.length}`;
---

<section class="faq container" aria-labelledby={id}>
  <h2 id={id} class="section-label title">{heading}</h2>
  <div class="list" data-accordion>
    {
      items.map((item) => (
        <details class="item" name={id}>
          <summary>
            <span class="q">{item.q}</span>
            <span class="icon icon-arrow-down-right" aria-hidden="true" />
          </summary>
          <div class="a-wrap">
            {Array.isArray(item.a) ? (
              <ol class="a steps">
                {item.a.map((step) => <li>{step}</li>)}
              </ol>
            ) : (
              <p class:list={['a', { unresolved: /CHECK|TODO/.test(item.a) }]}>{item.a}</p>
            )}
          </div>
        </details>
      ))
    }
  </div>
  <a class="link-arrow book" href={bookingUrl}>
    {bookLabel}
    <span class="icon icon-arrow-up-right" aria-hidden="true"></span>
  </a>
</section>

<script>
  // One open item at a time, opened and closed with a smooth height animation (Diana, design review).
  // Without JS the native <details name> still keeps one item open, just without the animation.
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const DURATION = 500;
  const EASE = 'cubic-bezier(0.22, 1, 0.36, 1)';

  function animate(item: HTMLDetailsElement, open: boolean) {
    const wrap = item.querySelector<HTMLElement>('.a-wrap');
    if (!wrap || reduce) {
      item.open = open;
      return;
    }
    if (open) item.open = true;
    const full = wrap.scrollHeight;
    const anim = wrap.animate(
      [{ height: open ? '0px' : `${full}px` }, { height: open ? `${full}px` : '0px' }],
      { duration: DURATION, easing: EASE },
    );
    item.classList.toggle('is-open', open);
    anim.onfinish = () => {
      if (!open) item.open = false;
    };
  }

  document.querySelectorAll<HTMLElement>('[data-accordion]').forEach((list) => {
    const items = [...list.querySelectorAll<HTMLDetailsElement>('details')];
    items.forEach((item) => {
      // JS takes over exclusivity, so the native name grouping is removed to avoid double toggles.
      item.removeAttribute('name');
      item.querySelector('summary')?.addEventListener('click', (event) => {
        event.preventDefault();
        const opening = !item.classList.contains('is-open');
        items.filter((other) => other !== item && other.classList.contains('is-open')).forEach((other) => animate(other, false));
        animate(item, opening);
      });
    });
  });
</script>

<style>
  /* Figma "faq" (6:349) and "faq - opened" (9:545). List column: 510 of the 1072px Figma column. */
  .faq {
    display: grid;
    grid-template-columns: minmax(0, 562fr) minmax(0, 510fr);
    grid-template-rows: auto 1fr;
    padding-top: 60px;
    padding-bottom: 32px;
  }
  .title {
    grid-column: 1;
    margin-top: 12px;
  }
  .list {
    grid-column: 2;
    grid-row: 1 / span 2;
  }
  .book {
    grid-column: 1;
    grid-row: 2;
    align-self: end;
    justify-self: start;
    margin-bottom: 4px;
  }
  .item {
    border-bottom: 1px dashed var(--color-dash);
  }
  summary {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-3) 0;
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  .q {
    flex: 1;
  }
  /* The ↘ arrow turns into ↗ when the item is open (rotated, so the change is smooth). */
  summary .icon {
    transition: transform 0.5s var(--ease-out);
  }
  .item[open] summary .icon,
  .item.is-open summary .icon {
    transform: rotate(-90deg);
  }
  .a-wrap {
    overflow: hidden;
  }
  .a {
    max-width: 486px;
    margin: 0;
    padding: 0 0 var(--space-3);
    font-size: var(--text-small);
  }
  .steps {
    padding-left: 1.25em;
  }
  .steps li + li {
    margin-top: 4px;
  }

  @media (prefers-reduced-motion: reduce) {
    summary .icon {
      transition: none;
    }
  }

  @media (max-width: 64rem) {
    .faq {
      grid-template-columns: 1fr;
      grid-template-rows: none;
      row-gap: var(--space-6);
      padding-top: var(--space-12);
      padding-bottom: var(--space-12);
    }
    .title,
    .list,
    .book {
      grid-column: 1;
      grid-row: auto;
    }
    .title {
      margin-top: 0;
    }
  }
</style>

---
import { Image } from 'astro:assets';
import heroDash from '../../assets/figma/hero-dash.svg?url';
import peek1 from '../../assets/figma/hero-hover-1.png';
import peek2 from '../../assets/figma/hero-hover-2.png';
import peek3 from '../../assets/figma/hero-hover-3.png';
import peek4 from '../../assets/figma/hero-hover-4.png';

interface Props {
  hero: {
    headline: string[];
    subline: string;
    guarantee: string[];
    button: string;
    proof: string;
  };
  bookingUrl: string;
}

const { hero, bookingUrl } = Astro.props;
const [l1, l2, l3, l4] = hero.headline;
// Pictures that fade in while the cursor moves over the headline (Figma frames "1"-"4" next to
// the Landing page). Listed left to right: the part of the headline under the cursor picks one.
// Positions are the Figma ones, in the 935px stage.
const peeks = [
  { src: peek2, x: -72, y: 96, w: 334, h: 356 },
  { src: peek4, x: 107, y: 224, w: 254, h: 292 },
  { src: peek3, x: 408, y: 32, w: 254, h: 292 },
  { src: peek1, x: 531, y: 333, w: 288, h: 332 },
];
---

<section class="hero" aria-labelledby="hero-title">
  <div class="stage">
    <div class="peeks" aria-hidden="true">
      {
        peeks.map((p) => (
          <Image
            class="peek"
            src={p.src}
            alt=""
            width={p.w}
            height={p.h}
            densities={[1, 2]}
            format="webp"
            loading="lazy"
            decoding="async"
            style={`left:${p.x}px;top:${p.y}px`}
          />
        ))
      }
    </div>
    <h1 id="hero-title" class="headline">
      <span class="l1">{l1}</span>
      <span class="l2">{l2}</span>
      <span class="l3">{l3}</span>
      <span class="l4">{l4}</span>
    </h1>
    <img class="dash" src={heroDash} alt="" width="39" height="41" />
    <a class="book btn-line" href={bookingUrl}>
      {hero.button}
      <span class="icon icon-arrow-right" aria-hidden="true"></span>
    </a>
    <div class="intro">
      <p class="subline">{hero.subline}</p>
      <p class="guarantee">
        {hero.guarantee.map((line, i) => (
          <>
            {i > 0 && <br />}
            {line}
          </>
        ))}
      </p>
    </div>
  </div>
  <p class="proof">{hero.proof}</p>
</section>

<script is:inline>
  // Hover pictures (Diana, design review 7): moving over the headline fades in the picture for
  // that part of it; leaving fades it out. Desktop with a mouse only; decorative, not clickable.
  (function () {
    var stage = document.querySelector('.hero .stage');
    if (!stage || !matchMedia('(hover: hover) and (pointer: fine)').matches) return;
    var peeks = stage.querySelectorAll('.peek');
    var spans = stage.querySelectorAll('.headline span');
    var BOUNDS = [230, 400, 620]; // stage x where the next picture takes over
    var current = -1;
    var hideTimer;
    function show(i) {
      clearTimeout(hideTimer);
      if (i === current) return;
      if (current >= 0) peeks[current].classList.remove('is-on');
      if (i >= 0) peeks[i].classList.add('is-on');
      current = i;
    }
    function onMove(e) {
      var x = e.clientX - stage.getBoundingClientRect().left;
      var i = 0;
      while (i < BOUNDS.length && x >= BOUNDS[i]) i++;
      show(i);
    }
    spans.forEach(function (span) {
      span.addEventListener('mousemove', onMove);
      // A short grace period, so moving between lines does not make the picture blink.
      span.addEventListener('mouseleave', function () {
        clearTimeout(hideTimer);
        hideTimer = setTimeout(function () { show(-1); }, 180);
      });
    });
  })();
</script>

<style>
  /* Desktop: the Figma Hero frame (3:4, 1280 x 832, nav included). The composition (935px wide,
     193px from the frame edge in Figma) stays centred whatever the screen width. */
  .hero {
    position: relative;
    height: 832px;
    margin-top: calc(-1 * var(--nav-h));
  }
  .stage {
    position: absolute;
    top: 0;
    bottom: 0;
    left: calc(50% - 447px); /* 640 - 193 */
    width: 935px;
  }
  /* Hover pictures: above the headline, never catch the mouse. Slow, soft fade with a slight
     settle; leaving is a little quicker. Shown only with the desktop composition. */
  .peeks {
    display: none;
  }
  .peek {
    position: absolute;
    z-index: 2;
    object-fit: cover;
    pointer-events: none;
    opacity: 0;
    transform: scale(1.04);
    filter: blur(6px);
    transition:
      opacity 0.6s var(--ease-out),
      transform 0.9s var(--ease-reveal),
      filter 0.6s var(--ease-out);
  }
  .peek.is-on {
    opacity: 1;
    transform: none;
    filter: none;
    transition:
      opacity 0.8s var(--ease-reveal),
      transform 1.1s var(--ease-reveal),
      filter 0.8s var(--ease-reveal);
  }
  @media (hover: hover) and (pointer: fine) and (min-width: 75rem) {
    .peeks {
      display: block;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .peek,
    .peek.is-on {
      transform: none;
      filter: none;
    }
  }
  .headline {
    font-family: var(--font-display);
    font-size: 52px;
    font-weight: var(--weight-regular);
  }
  .headline span {
    position: absolute;
    white-space: nowrap;
  }
  .l1 {
    left: 0;
    top: 191px;
  }
  .l2 {
    left: 70px;
    top: 254px;
  }
  .l3,
  .l4 {
    line-height: 56px;
    text-align: right;
  }
  .l3 {
    right: calc(100% - 758px);
    top: 280px;
  }
  .l4 {
    right: calc(100% - 895px);
    top: 336px;
  }
  .dash {
    position: absolute;
    left: 388px;
    top: 280px;
  }
  .book {
    position: absolute;
    right: calc(100% - 260px);
    top: 516px;
  }
  .intro {
    position: absolute;
    left: 553px;
    top: 516px;
    width: 382px;
  }
  .subline {
    text-align: justify;
  }
  .guarantee {
    margin-top: 1.0625rem;
    font-family: var(--font-mono);
    font-size: var(--text-small);
    font-style: italic;
  }
  .proof {
    position: absolute;
    left: var(--gutter);
    right: var(--gutter);
    bottom: 1px;
    font-size: var(--text-small);
    letter-spacing: var(--tracking-small);
    text-align: center;
  }

  /* Load-in (Diana, design reviews 3-5): the hero assembles in about 2.4s, unhurried. Headline lines come out
     of a soft blur one after another, the dash fades in, the button arrives from the left and the
     intro from the right, the proof line fades in last. Only when motion is allowed. */
  @keyframes hero-blur {
    from {
      opacity: 0;
      filter: blur(12px);
      transform: translateY(18px);
    }
  }
  @keyframes hero-fade {
    from {
      opacity: 0;
    }
  }
  @keyframes hero-left {
    from {
      opacity: 0;
      transform: translateX(-32px);
    }
  }
  @keyframes hero-right {
    from {
      opacity: 0;
      transform: translateX(32px);
    }
  }
  :global(.reveal) .headline span {
    animation: hero-blur 1.3s var(--ease-reveal) both;
  }
  :global(.reveal) .headline .l1 {
    animation-delay: 0.1s;
  }
  :global(.reveal) .headline .l2 {
    animation-delay: 0.26s;
  }
  :global(.reveal) .headline .l3 {
    animation-delay: 0.44s;
  }
  :global(.reveal) .headline .l4 {
    animation-delay: 0.6s;
  }
  :global(.reveal) .dash {
    animation: hero-fade 1.2s var(--ease-reveal) 0.55s both;
  }
  :global(.reveal) .book {
    animation: hero-left 1.3s var(--ease-reveal) 0.85s both;
  }
  :global(.reveal) .intro {
    animation: hero-right 1.3s var(--ease-reveal) 0.95s both;
  }
  :global(.reveal) .proof {
    animation: hero-fade 1.3s var(--ease-reveal) 1.15s both;
  }

  /* Provisional below the desktop frame: stack in reading order. */
  @media (max-width: 74.99rem) {
    .hero {
      height: auto;
      margin-top: 0;
      padding: var(--space-16) var(--gutter) var(--space-8);
    }
    .stage {
      position: static;
      width: auto;
      display: flex;
      flex-direction: column;
      gap: var(--space-8);
    }
    .headline {
      font-size: var(--text-display);
      line-height: var(--leading-display);
    }
    .headline span,
    .dash,
    .book,
    .intro,
    .proof {
      position: static;
    }
    .headline span {
      display: block;
      white-space: normal;
      text-align: left;
    }
    .l2 {
      padding-left: 1.5em;
    }
    .dash {
      display: none;
    }
    .book {
      align-self: flex-start;
    }
    .intro {
      width: auto;
      max-width: 382px;
    }
    .proof {
      margin-top: var(--space-8);
      text-align: left;
    }
  }
</style>

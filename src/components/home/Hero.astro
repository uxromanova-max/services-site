---
import heroDash from '../../assets/figma/hero-dash.svg?url';

interface Props {
  hero: {
    headline: string[];
    subline: string;
    guarantee: string[];
    button: string;
    proof: string;
  };
  bookingUrl: string;
}

const { hero, bookingUrl } = Astro.props;
const [l1, l2, l3, l4] = hero.headline;
---

<section class="hero" aria-labelledby="hero-title">
  <div class="stage">
    <h1 id="hero-title" class="headline">
      <span class="l1">{l1}</span>
      <span class="l2">{l2}</span>
      <span class="l3">{l3}</span>
      <span class="l4">{l4}</span>
    </h1>
    <img class="dash" src={heroDash} alt="" width="39" height="41" />
    <a class="book" href={bookingUrl}>
      {hero.button}
      <span class="icon icon-arrow-right" aria-hidden="true"></span>
    </a>
    <div class="intro">
      <p class="subline">{hero.subline}</p>
      <p class="guarantee">
        {hero.guarantee.map((line, i) => (
          <>
            {i > 0 && <br />}
            {line}
          </>
        ))}
      </p>
    </div>
  </div>
  <p class="proof">{hero.proof}</p>
</section>

<style>
  /* Desktop: the Figma Hero frame (3:4, 1280 x 832, nav included). The composition (935px wide,
     193px from the frame edge in Figma) stays centred whatever the screen width. */
  .hero {
    position: relative;
    height: 832px;
    margin-top: calc(-1 * var(--nav-h));
  }
  .stage {
    position: absolute;
    top: 0;
    bottom: 0;
    left: calc(50% - 447px); /* 640 - 193 */
    width: 935px;
  }
  .headline {
    font-family: var(--font-display);
    font-size: 52px;
    font-weight: var(--weight-regular);
  }
  .headline span {
    position: absolute;
    white-space: nowrap;
  }
  .l1 {
    left: 0;
    top: 191px;
  }
  .l2 {
    left: 70px;
    top: 254px;
  }
  .l3,
  .l4 {
    line-height: 56px;
    text-align: right;
  }
  .l3 {
    right: calc(100% - 758px);
    top: 280px;
  }
  .l4 {
    right: calc(100% - 895px);
    top: 336px;
  }
  .dash {
    position: absolute;
    left: 388px;
    top: 280px;
  }
  .book {
    position: absolute;
    right: calc(100% - 260px);
    top: 516px;
    display: inline-flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-2) var(--space-8);
    border-bottom: 1px solid currentColor;
    font-weight: var(--weight-regular);
    text-decoration: none;
    white-space: nowrap;
  }
  .intro {
    position: absolute;
    left: 553px;
    top: 516px;
    width: 382px;
  }
  .subline {
    text-align: justify;
  }
  .guarantee {
    margin-top: 1.0625rem;
    font-family: var(--font-mono);
    font-size: var(--text-small);
    font-style: italic;
  }
  .proof {
    position: absolute;
    left: var(--gutter);
    right: var(--gutter);
    bottom: 1px;
    font-size: var(--text-small);
    letter-spacing: var(--tracking-small);
    text-align: center;
  }

  /* Provisional below the desktop frame: stack in reading order. */
  @media (max-width: 74.99rem) {
    .hero {
      height: auto;
      margin-top: 0;
      padding: var(--space-16) var(--gutter) var(--space-8);
    }
    .stage {
      position: static;
      width: auto;
      display: flex;
      flex-direction: column;
      gap: var(--space-8);
    }
    .headline {
      font-size: var(--text-display);
      line-height: var(--leading-display);
    }
    .headline span,
    .dash,
    .book,
    .intro,
    .proof {
      position: static;
    }
    .headline span {
      display: block;
      white-space: normal;
      text-align: left;
    }
    .l2 {
      padding-left: 1.5em;
    }
    .dash {
      display: none;
    }
    .book {
      align-self: flex-start;
    }
    .intro {
      width: auto;
      max-width: 382px;
    }
    .proof {
      margin-top: var(--space-8);
      text-align: left;
    }
  }
</style>
